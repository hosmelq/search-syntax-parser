{
    "name": "hosmelq/search-syntax-parser",
    "description": "Parse search queries into structured data with field searches, boolean logic, ranges, lists, and adapters.",
    "license": "MIT",
    "keywords": [
        "ast",
        "dsl",
        "lexer",
        "query-language",
        "query-parser",
        "search-query",
        "search-syntax",
        "tokenizer"
    ],
    "authors": [
        {
            "name": "Hosmel Quintana",
            "email": "hosmelq@gmail.com"
        }
    ],
    "homepage": "https://github.com/hosmelq/search-syntax-parser",
    "support": {
        "docs": "https://hosmelq.com/docs/search-syntax-parser"
    },
    "require": {
        "php": "^8.4",
        "brick/math": "^0.14.4 || ^0.15 || ^0.16 || ^0.17 || ^0.18 || ^0.19 || ^0.20 || ^1.0"
    },
    "require-dev": {
        "ergebnis/composer-normalize": "^2.57",
        "hosmelq/php-coding-standard": "^1.5",
        "pestphp/pest": "^5.3",
        "pestphp/pest-plugin-agent": "^5.0",
        "pestphp/pest-plugin-rector": "^5.0",
        "shipmonk/composer-dependency-analyser": "^1.8"
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "autoload": {
        "psr-4": {
            "HosmelQ\\SearchSyntaxParser\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "HosmelQ\\SearchSyntaxParser\\Tests\\": "tests/"
        }
    },
    "config": {
        "allow-plugins": {
            "ergebnis/composer-normalize": true,
            "pestphp/pest-plugin": true,
            "phpstan/extension-installer": true
        },
        "sort-packages": true
    },
    "scripts": {
        "ecs": "ecs check --fix=true",
        "ecs:check": "ecs check",
        "phpstan": "phpstan analyse --configuration=phpstan.neon.dist --memory-limit=4G",
        "rector": "rector",
        "test": "pest",
        "test-coverage": "pest --coverage"
    },
    "scripts-descriptions": {
        "ecs": "Format PHP code using the shared ECS set.",
        "ecs:check": "Check PHP formatting using the shared ECS set.",
        "phpstan": "Run PHPStan static analysis.",
        "rector": "Run Rector automated refactoring.",
        "test": "Run the test suite using Pest.",
        "test-coverage": "Run the test suite with code coverage using Pest."
    },
    "$schema": "https://getcomposer.org/schema.json"
}
