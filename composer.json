{
    "name": "hosmelq/search-syntax-parser",
    "description": "Parse search queries into structured data with field searches, boolean logic, ranges, and lists.",
    "license": "MIT",
    "keywords": [
        "ast",
        "boolean-search",
        "hosmelq",
        "parser",
        "php",
        "query-language",
        "query-parser",
        "search",
        "search-query",
        "search-syntax",
        "search-syntax-parser"
    ],
    "authors": [
        {
            "name": "Hosmel Quintana",
            "email": "hosmelq@gmail.com"
        }
    ],
    "homepage": "https://hosmelq.com/docs/search-syntax-parser",
    "support": {
        "docs": "https://hosmelq.com/docs/search-syntax-parser"
    },
    "require": {
        "php": "^8.4",
        "ext-mbstring": "*",
        "brick/math": "^0.14.4 || ^0.15 || ^0.16 || ^0.17 || ^0.18 || ^0.19 || ^0.20 || ^1.0"
    },
    "require-dev": {
        "ergebnis/composer-normalize": "^2.57.0",
        "hosmelq/php-coding-standard": "^1.5.0",
        "pestphp/pest": "^5.3.6",
        "pestphp/pest-plugin-agent": "^5.0.0",
        "pestphp/pest-plugin-rector": "^5.0.6",
        "shipmonk/composer-dependency-analyser": "^1.8.4"
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "autoload": {
        "psr-4": {
            "HosmelQ\\SearchSyntaxParser\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "HosmelQ\\SearchSyntaxParser\\Tests\\": "tests/"
        }
    },
    "config": {
        "allow-plugins": {
            "ergebnis/composer-normalize": true,
            "pestphp/pest-plugin": true,
            "phpstan/extension-installer": true
        },
        "sort-packages": true
    },
    "scripts": {
        "ecs": "ecs check --fix",
        "phpstan": "phpstan analyse --memory-limit=4G",
        "rector": "rector",
        "test": "pest",
        "test-coverage": "pest --coverage"
    },
    "scripts-descriptions": {
        "ecs": "Runs ECS.",
        "phpstan": "Runs PHPStan analyse.",
        "rector": "Runs Rector.",
        "test": "Runs the Pest test suite.",
        "test-coverage": "Runs the Pest test suite with code coverage."
    },
    "$schema": "https://getcomposer.org/schema.json"
}
