includes:
  - vendor/hosmelq/php-coding-standard/config/phpstan-php.neon

parameters:
  ignoreErrors:
    # Native preg_* calls check failures without a runtime Safe dependency.
    - identifier: theCodingMachineSafe.function
    # Native DateTimeImmutable constructors throw on invalid input; Safe is not a runtime dependency.
    - identifier: theCodingMachineSafe.class
      path: src/Date/DateValue.php
  paths:
    - src
  phpVersion:
    max: 80599
    min: 80400
